<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

    <!--
        ════════════════════════════════════════════════════════
         Connection String Configuration
         ────────────────────────────────────────────────────────
         Server    : Change (local) to your SQL Server instance name.
                     Examples:
                       (local)\SQLEXPRESS   → LocalDB / Express
                       .\MSSQLSERVER        → Default instance on this PC
                       192.168.1.10         → Remote server by IP
         Database  : The name of your dental clinic database.
         Integrated Security = True  → Windows Authentication (no password).
         If you use SQL Authentication instead, replace with:
                     User Id=sa;Password=YourPass;
        ════════════════════════════════════════════════════════
    -->
    <connectionStrings>
        <add name="DentalClinicDB"
             connectionString="Server=(local);Database=DentalClinicDB;Integrated Security=True;TrustServerCertificate=True;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>

</configuration>